{
  "name": "how-much-did-u-waste",
  "version": "0.0.3-beta",
  "type": "module",
  "license": "MIT",
  "description": "Local-first, read-only cost & activity dashboard for coding agents (Claude Code, Codex, Qwen): API-equivalent spend, token-leak detection, skills and memory. Binds to 127.0.0.1 only.",
  "author": "Adudu02",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adudu02/How-much-did-U-waste.git"
  },
  "homepage": "https://github.com/Adudu02/How-much-did-U-waste#readme",
  "bugs": {
    "url": "https://github.com/Adudu02/How-much-did-U-waste/issues"
  },
  "keywords": [
    "cli",
    "dashboard",
    "tokens",
    "cost",
    "usage",
    "llm",
    "ai-agents",
    "claude-code",
    "codex",
    "qwen"
  ],
  "bin": {
    "how-much-did-u-waste": "bin/how-much-did-u-waste.mjs"
  },
  "files": [
    "bin",
    "dist",
    "web/dist",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "update": "node scripts/start.mjs --update",
    "launcher": "bash scripts/install-launcher.sh",
    "cli": "tsx src/cli.ts",
    "pricing:update": "tsx src/pricing-update-cli.ts",
    "quota": "tsx src/quota-cli.ts",
    "rebuild": "tsx src/rebuild.ts",
    "improve": "tsx src/improve.ts",
    "serve": "tsx src/server.ts",
    "dev": "concurrently -k -n api,web \"pnpm serve\" \"pnpm web\"",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite --config web/vite.config.ts build",
    "build:server": "tsc -p tsconfig.build.json",
    "build:core": "pnpm --filter how-much-did-u-waste-core build",
    "build:insights": "pnpm --filter how-much-did-u-waste-insights build",
    "build:report": "pnpm --filter how-much-did-u-waste-report build",
    "build": "pnpm build:core && pnpm build:insights && pnpm build:report && pnpm build:web && pnpm build:server",
    "prepublishOnly": "pnpm build",
    "test": "pnpm --filter how-much-did-u-waste-core test && pnpm --filter how-much-did-u-waste-insights test && pnpm --filter how-much-did-u-waste-report test && vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src test packages/core/src packages/core/test packages/reporter/src packages/reporter/test web/src",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "fastify": "^5.12.4",
    "how-much-did-u-waste-core": "workspace:*",
    "how-much-did-u-waste-insights": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0"
}
