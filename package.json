{
  "name": "motor-agentico",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Dashboard local (solo lectura) de costos/actividad de agentes: adapters Claude Code + Codex, motor de costos equiv-API, detección de fugas de tokens y ahorro, memoria y skills. Bindea solo a 127.0.0.1.",
  "bin": {
    "motor-agentico": "bin/motor-agentico.mjs"
  },
  "files": [
    "bin",
    "dist",
    "web/dist",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "launcher": "bash scripts/install-launcher.sh",
    "cli": "tsx src/cli.ts",
    "rebuild": "tsx src/rebuild.ts",
    "improve": "tsx src/improve.ts",
    "serve": "tsx src/server.ts",
    "dev": "concurrently -k -n api,web \"pnpm serve\" \"pnpm web\"",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite --config web/vite.config.ts build",
    "build:server": "tsc -p tsconfig.build.json",
    "build:core": "pnpm --filter motor-agentico-core build",
    "build:report": "pnpm --filter motor-agentico-report build",
    "build": "pnpm build:core && pnpm build:report && pnpm build:web && pnpm build:server",
    "prepublishOnly": "pnpm build",
    "test": "pnpm --filter motor-agentico-core test && pnpm --filter motor-agentico-report test && vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src test packages/core/src packages/core/test packages/reporter/src packages/reporter/test web/src",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "motor-agentico-core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0"
}