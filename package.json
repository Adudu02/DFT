{
  "name": "motor-agentico",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard local (solo lectura) de costos/actividad de agentes: adapters Claude Code + Codex, motor de costos equiv-API, detección de fugas de tokens y ahorro, memoria y skills. Bindea solo a 127.0.0.1.",
  "scripts": {
    "start": "node scripts/start.mjs",
    "launcher": "bash scripts/install-launcher.sh",
    "cli": "tsx src/cli.ts",
    "rebuild": "tsx src/rebuild.ts",
    "improve": "tsx src/improve.ts",
    "serve": "tsx src/server.ts",
    "dev": "concurrently -k -n api,web \"pnpm serve\" \"pnpm web\"",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite --config web/vite.config.ts build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src test web/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.18.0"
}
