{
  "name": "motor-agentico-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Motor de costos/actividad/fugas de agentes de IA (Claude Code, Codex, Qwen). Solo lectura sobre las fuentes; librería sin servidor ni UI.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
