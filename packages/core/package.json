  "description": "Cost/activity/token-leak engine for AI coding agents (Claude Code, Codex, Qwen). Read-only over the sources; library without server or UI.",
  "license": "MIT",
  "author": "Adudu02",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adudu02/How-much-did-U-waste.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Adudu02/How-much-did-U-waste#readme",
  "bugs": {
    "url": "https://github.com/Adudu02/How-much-did-U-waste/issues"
  },
  "keywords": [
    "llm",
    "ai-agents",
    "claude-code",
    "codex",
    "qwen",
    "tokens",
    "cost",
    "usage",
    "sqlite",
    "analytics"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
